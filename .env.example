# Copy to .env.local and fill locally or in Vercel's server-side settings.
# Never commit actual credentials. Blank values disable optional integrations.

# MongoDB destination: gvb-tech.enquiries
MONGODB_URI=

# Google Generative AI chat provider (server only)
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional; ensure the chosen model is available to the provider account.
GVB_GEMINI_MODEL=gemini-2.0-flash
