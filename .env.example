# Copy to .env.local and fill locally or in Vercel's server-side settings.
# Never commit actual credentials. Blank values disable optional integrations.

# MongoDB destination: gvb-tech.enquiries
MONGODB_URI=

# Google Generative AI chat provider (server only)
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional; ensure the chosen model is available to the provider account.
GVB_GEMINI_MODEL=gemini-2.0-flash

# Optional WeaveCore photo analysis. Configure the provider key and quota before enabling.
WEAVECORE_VISION_ENABLED=false
WEAVECORE_VISION_PROVIDER=gemini
WEAVECORE_VISION_API_KEY=
# Allow Gemini analysis to reuse the site chat key when a dedicated key is absent.
WEAVECORE_VISION_USE_SITE_KEY=false
# Defaults to gemini-3.8-flash or qwen3-vl:4b, depending on the provider.
WEAVECORE_VISION_MODEL=
